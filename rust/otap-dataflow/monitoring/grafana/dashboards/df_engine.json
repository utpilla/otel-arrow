{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Cores in use",
      "description": "Number of distinct CPU core IDs that have pipeline metrics. Reflects how many engine cores are running pipeline work.",
      "id": 10,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(count by(core_id)(memory_usage{set=\"pipeline.metrics\"}))",
          "legendFormat": "cores",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },
    {
      "type": "stat",
      "title": "CPU (% of all cores)",
      "description": "Process-wide CPU as a fraction of all logical CPUs on the machine. From engine.metrics.cpu_utilization. One row per df_engine run (process_instance_id label, settable via --run-label).",
      "id": 11,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "cpu_utilization{set=\"engine.metrics\"} * 100",
          "legendFormat": "{{process_instance_id}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": true, "limit": 10 },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red",    "value": 90 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Memory (RSS)",
      "description": "Resident Set Size of df_engine.exe. From engine.metrics.memory_rss. One row per df_engine run (process_instance_id label, settable via --run-label).",
      "id": 12,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "memory_rss{set=\"engine.metrics\"}",
          "legendFormat": "{{process_instance_id}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": true, "limit": 10 },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },
    {
      "type": "stat",
      "title": "Logs exported / sec",
      "description": "Per-second rate of LogRecords successfully uploaded to Geneva. One row per df_engine run (process_instance_id label, settable via --run-label).",
      "id": 13,
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by(process_instance_id)(rate(log_records_uploaded{set=\"otap.exporter.geneva\"}[30s]))",
          "legendFormat": "{{process_instance_id}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": true, "limit": 10 },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green",  "value": 100 }
            ]
          }
        }
      }
    },

    {
      "type": "timeseries",
      "title": "CPU utilization (% of all cores)",
      "description": "Process-wide CPU over time. One line per df_engine run.",
      "id": 20,
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "cpu_utilization{set=\"engine.metrics\"} * 100",
          "legendFormat": "{{process_instance_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "mean", "max"]
        },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory (RSS)",
      "description": "Resident Set Size over time. One line per df_engine run.",
      "id": 21,
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "memory_rss{set=\"engine.metrics\"}",
          "legendFormat": "{{process_instance_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "mean", "max"]
        },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "type": "timeseries",
      "title": "Logs exported / sec (Geneva)",
      "description": "Per-second export rate as a continuous chart. One line per df_engine run.",
      "id": 22,
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by(process_instance_id)(rate(log_records_uploaded{set=\"otap.exporter.geneva\"}[30s]))",
          "legendFormat": "{{process_instance_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "mean", "max"]
        },
        "tooltip": { "mode": "single" }
      }
    }
  ],
  "refresh": "2s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["df_engine"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
